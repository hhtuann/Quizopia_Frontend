# Quizopia_Frontend environment TEMPLATE — copy to .env.local for local Next.js.
# Only browser-safe values may use the NEXT_PUBLIC_ prefix.
# NEVER put OPENAI_API_KEY, JWT, Google client secret or other backend secrets here.
#
# Browser-reachable Spring Boot URL:
#   Docker Compose (System root): http://localhost:8080
#   Standalone local backend running on port 8181: http://localhost:8181
# Change this to match your actual backend, then restart Next.js dev server.
# NEXT_PUBLIC_* values are bundled at Next.js BUILD TIME in production Docker.
NEXT_PUBLIC_API_URL=http://localhost:8080
